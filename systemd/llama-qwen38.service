[Unit]
Description=LLaMA.cpp Server - Qwen 3.8 27B Q8_0
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/llama.cpp/build/bin
ExecStart=/opt/llama.cpp/build/bin/llama-server \
  --model /opt/models/Qwen3.8-27B-Q4_K_M.gguf \
  --alias Qwen3.8-27B-Q4_K_M \
  --mmproj /opt/models/mmproj-Qwen3.8-27B-Q8_0.gguf \
  --n-gpu-layers 99 \
  --ctx-size 262144 \
  -n 65536 \
  --cache-type-k q8_0 \
  --cache-type-v q8_0 \
  --cache-ram 0 \
  --parallel 1 \
  --no-warmup \
  --flash-attn on \
  --agent \
  --mcp-servers-config /opt/search/mcp-servers.json \
  --jinja \
  -b 256 \
  --host 0.0.0.0 \
  --port 8082
Restart=no
RestartSec=10
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

