[Unit]
Description=LLaMA.cpp Server - Ornith 1.5 35B A3B Uncensored Q8_0
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/llama.cpp/build/bin
ExecStart=/opt/llama.cpp/build/bin/llama-server \
  --model /opt/models/Ornith-1.5-35B-A3B-Uncensored-Q8_0.gguf \
  --alias Ornith-1.5-35B-A3B-Uncensored \
  --mmproj /opt/models/mmproj-Ornith-1.5-35B-A3B-Uncensored-f16.gguf \
  --n-gpu-layers 99 \
  --ctx-size 524288 \
  -n -1 \
  --rope-scaling yarn \
  --yarn-orig-ctx 262144 \
  --rope-freq-scale 2.0 \
  --override-kv qwen35moe.context_length=int:524288 \
  --cache-type-k q8_0 \
  --cache-type-v q8_0 \
  --cache-ram 0 \
  --parallel 1 \
  --no-warmup \
  --flash-attn on \
  --agent \
  --mcp-servers-config /opt/search/mcp-servers.json \
  --jinja \
  -b 256 \
  --keep -1 \
  --host 0.0.0.0 \
  --port 8080 \
  --image-min-tokens 1024 \
  --cors-origins "*"
Restart=no
RestartSec=10
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
