[Unit]
Description=LLaMA.cpp TEST (Zen4+AVX512) - Qwen 3.8 Flash Next (Multimodal, 256k ctx)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/llama.cpp-test/build/bin
ExecStart=/opt/llama.cpp-test/build/bin/llama-server \
    --model /opt/models/Qwen3.8-Flash-Next-GGUF/Qwen3.8-Flash-Next-UD-IQ4_XS-00001-of-00003.gguf \
    --mmproj /opt/models/Qwen3.8-Flash-Next-GGUF/mmproj-BF16.gguf \
    --alias Qwen3.8-Flash-Next \
    --n-gpu-layers 99 \
    --ctx-size 262144 \
    -n 65536 \
    --cache-type-k q8_0 \
    --cache-type-v q8_0 \
    --cache-ram 0 \
    --parallel 1 \
    --no-warmup \
    --flash-attn on \
  --agent \
  --mcp-servers-config /opt/search/mcp-servers.json \
  --jinja \
    -b 2048 \
    --host 0.0.0.0 \
    --port 8083
Restart=no
RestartSec=10
LimitNOFILE=65536
Environment="LD_LIBRARY_PATH=/opt/llama.cpp-test/build/bin"

[Install]
WantedBy=multi-user.target
